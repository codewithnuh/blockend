{
  "name": "blockend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint . && turbo run lint",
    "lint:fix": "oxlint --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "turbo run typecheck",
    "typecheck:blocks": "tsc --noEmit -p blocks/tsconfig.json",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm typecheck:blocks && pnpm test",
    "prepare": "husky"
  },
  "keywords": [
    "blocks",
    "backend",
    "hono",
    "fastify",
    "express",
    "backend-blocks",
    "nodejs",
    "typescript"
  ],
  "author": "codewithnuh",
  "license": "MIT",
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
  "dependencies": {
    "prettier": "^3.8.4",
    "turbo": "^2.10.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@hono/node-server": "^2.1.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "fastify": "^5.12.0",
    "fastify-plugin": "^6.0.0",
    "hono": "^4.13.2",
    "husky": "^9.1.7",
    "ioredis": "^5.11.1",
    "lint-staged": "^17.0.7",
    "mitata": "^1.0.34",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx,jsx,json,jsonc,md,mdx,yml,yaml,css,scss,html}": [
      "prettier --write"
    ],
    "*.{js,cjs,mjs,ts,tsx,jsx}": [
      "oxlint --fix"
    ]
  }
}
