{
  "name": "blockend-cli",
  "version": "2.0.0",
  "description": "Blockend CLI — shadcn/ui-style backend blocks for TypeScript. Generate production-ready rate limiting, validation, logging, and error handling as source code into Express, Fastify, Hono, or Next.js projects. You own the code. Ships an MCP server for AI coding assistants.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "blockend": "./dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean --out-dir dist && tsc --emitDeclarationOnly --declaration",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "blockend",
    "shadcn",
    "backend-boilerplate",
    "backend-starter",
    "code-generation",
    "scaffolding",
    "typescript",
    "express",
    "express-middleware",
    "fastify",
    "fastify-plugin",
    "hono",
    "hono-middleware",
    "nextjs",
    "middleware",
    "rate-limiting",
    "rate-limiter",
    "request-validation",
    "error-handling",
    "logging",
    "idempotency",
    "password-hashing",
    "argon2",
    "api-security",
    "mcp",
    "mcp-server",
    "developer-tools"
  ],
  "homepage": "https://blockend.noorulhassan.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codewithnuh/blockend.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/codewithnuh/blockend/issues"
  },
  "author": "codewithnuh",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.2",
  "dependencies": {
    "@clack/prompts": "^1.5.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "citty": "^0.2.2",
    "commander": "^15.0.0",
    "execa": "^9.6.1",
    "picocolors": "^1.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "tsup": "^8.5.1",
    "vitest": "^1.6.1"
  }
}
