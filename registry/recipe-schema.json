{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://blockend.noorulhassan.com/recipe-schema.json",
  "title": "BlockendRecipeCollection",
  "$comment": "Generated from packages/registry/src/schema.ts. Do not edit manually.",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "version": {
      "type": "string",
      "minLength": 1,
      "description": "Version of the recipe collection format."
    },
    "recipes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
            "description": "Stable URL-safe recipe identifier."
          },
          "title": { "type": "string", "minLength": 1 },
          "outcome": {
            "type": "string",
            "minLength": 1,
            "description": "What a developer will have after following the recipe."
          },
          "includedBlocks": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
            },
            "uniqueItems": true
          },
          "optionalBlocks": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
            },
            "uniqueItems": true
          },
          "integrationOrder": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
            },
            "uniqueItems": true,
            "description": "A complete ordering of included and optional blocks, respecting registry requirements."
          },
          "architecture": {
            "type": "object",
            "properties": {
              "overview": { "type": "string", "minLength": 1 },
              "components": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string", "minLength": 1 },
                    "description": { "type": "string", "minLength": 1 },
                    "block": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
                    }
                  },
                  "required": ["name", "description"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["overview", "components"],
            "additionalProperties": false
          },
          "assumptions": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "configuration": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "description": { "type": "string", "minLength": 1 },
                "required": { "type": "boolean" },
                "default": { "type": "string" }
              },
              "required": ["name", "description", "required"],
              "additionalProperties": false
            }
          },
          "tradeoffs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "choice": { "type": "string", "minLength": 1 },
                "tradeoff": { "type": "string", "minLength": 1 }
              },
              "required": ["choice", "tradeoff"],
              "additionalProperties": false
            }
          },
          "alternatives": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": { "type": "string", "minLength": 1 },
                "description": { "type": "string", "minLength": 1 }
              },
              "required": ["title", "description"],
              "additionalProperties": false
            }
          },
          "failureBehavior": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "scenario": { "type": "string", "minLength": 1 },
                "behavior": { "type": "string", "minLength": 1 }
              },
              "required": ["scenario", "behavior"],
              "additionalProperties": false
            }
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": { "type": "string", "minLength": 1 },
                "command": { "type": "string", "minLength": 1 }
              },
              "required": ["label", "command"],
              "additionalProperties": false
            }
          },
          "relatedContent": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": { "type": "string", "minLength": 1 },
                "href": { "type": "string", "pattern": "^(https:\\/\\/|\\/)" }
              },
              "required": ["title", "href"],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "slug",
          "title",
          "outcome",
          "includedBlocks",
          "optionalBlocks",
          "integrationOrder",
          "architecture",
          "assumptions",
          "configuration",
          "tradeoffs",
          "failureBehavior",
          "commands",
          "relatedContent"
        ],
        "additionalProperties": false
      },
      "description": "Production-ready backend recipes published by Blockend."
    }
  },
  "required": ["version", "recipes"],
  "additionalProperties": false
}
