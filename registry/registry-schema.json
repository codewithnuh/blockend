{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BlockendRegistryManifest",
  "type": "object",
  "required": ["version", "blocks"],
  "properties": {
    "version": {
      "type": "string",
      "description": "The semantic version of the registry schema layout."
    },
    "blocks": {
      "type": "object",
      "description": "Dictionary lookup table of all available ingestible component blocks.",
      "additionalProperties": {
        "type": "object",
        "required": ["name", "description"],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "version": {
            "type": "string",
            "description": "Semantic version of this block (e.g. \"1.0.0\"). Used for update tracking."
          },
          "frameworks": {
            "type": "array",
            "description": "Explicit framework support list.",
            "items": {
              "type": "string",
              "enum": ["express", "fastify", "hono", "next", "*"]
            },
            "uniqueItems": true
          },
          "releasedAt": {
            "type": "string",
            "description": "ISO calendar date (YYYY-MM-DD) when this block was first released.",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "runtimes": {
            "type": "object",
            "description": "Supported runtime engine ranges (semver range strings), e.g. {\"node\": \">=20\"}.",
            "propertyNames": {
              "enum": ["node"]
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "requires": {
            "type": "array",
            "description": "Registry slugs that must be installed alongside this block.",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
            },
            "uniqueItems": true
          },
          "related": {
            "type": "array",
            "description": "Registry slugs that pair well with this block (soft catalog links).",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
            },
            "uniqueItems": true
          },
          "conflicts": {
            "type": "array",
            "description": "Registry slugs that must not be installed together with this block.",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
            },
            "uniqueItems": true
          },
          "dependencies": {
            "type": "array",
            "description": "Production dependencies. Each entry can be a bare name (\"vitest\") or include a version range (\"vitest@^4.0.0\").",
            "items": {
              "type": "string",
              "pattern": "^[a-z@][a-z0-9._/-]*(@[~^>=<]*[0-9]+(\\.[0-9]+)*)?$"
            }
          },
          "devDependencies": {
            "type": "array",
            "description": "Dev dependencies. Each entry can be a bare name or include a version range.",
            "items": {
              "type": "string",
              "pattern": "^[a-z@][a-z0-9._/-]*(@[~^>=<]*[0-9]+(\\.[0-9]+)*)?$"
            }
          },
          "baseFiles": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/assetMapping"
            }
          },
          "adapters": {
            "type": "object",
            "description": "Framework adapter mappings.",
            "propertyNames": {
              "enum": ["express", "fastify", "hono", "next", "*"]
            },
            "additionalProperties": {
              "$ref": "#/definitions/frameworkMapping"
            }
          },
          "environments": {
            "type": "object",
            "description": "Legacy framework mappings.",
            "propertyNames": {
              "enum": ["express", "fastify", "hono", "next", "*"]
            },
            "additionalProperties": {
              "$ref": "#/definitions/frameworkMapping"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "definitions": {
    "assetMapping": {
      "type": "object",
      "required": ["source", "target"],
      "properties": {
        "source": {
          "type": "string",
          "description": "Remote template path."
        },
        "target": {
          "type": "string",
          "description": "Destination path."
        }
      },
      "additionalProperties": false
    },
    "frameworkMapping": {
      "type": "object",
      "required": ["variants"],
      "properties": {
        "core": {
          "type": "string",
          "description": "Optional fallback template."
        },
        "dependencies": {
          "type": "array",
          "description": "Dependencies for this adapter. Supports version ranges (e.g. \"express@^4.18.0\").",
          "items": {
            "type": "string"
          }
        },
        "devDependencies": {
          "type": "array",
          "description": "Dev dependencies for this adapter. Supports version ranges.",
          "items": {
            "type": "string"
          }
        },
        "variants": {
          "type": "object",
          "description": "Storage layout strategies.",
          "additionalProperties": {
            "type": "object",
            "required": ["files"],
            "properties": {
              "dependencies": {
                "type": "array",
                "description": "Variant-specific dependencies. Supports version ranges.",
                "items": {
                  "type": "string"
                }
              },
              "devDependencies": {
                "type": "array",
                "description": "Variant-specific dev dependencies. Supports version ranges.",
                "items": {
                  "type": "string"
                }
              },
              "files": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "$ref": "#/definitions/assetMapping"
                    }
                  ]
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
